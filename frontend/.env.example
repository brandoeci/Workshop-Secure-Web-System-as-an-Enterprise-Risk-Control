# Copy to .env.local (git-ignored) and fill in with your own Auth0 values.
# None of these is a secret: an SPA ships the client ID, never a client secret.
VITE_AUTH0_DOMAIN=YOUR_TENANT.us.auth0.com
VITE_AUTH0_CLIENT_ID=YOUR_CLIENT_ID
VITE_AUTH0_AUDIENCE=https://enterprise-risk-api

# Local development
VITE_API_URL=http://localhost:8080
# In production, same origin as the site, proxied by Apache over TLS:
# VITE_API_URL=https://YOUR-SUBDOMAIN.duckdns.org
